# AI Studio automatically supplies GEMINI_API_KEY as a server-side secret.
GEMINI_API_KEY=

# Exact frozen Dove cosine threshold was not recoverable from the supplied prototype.
# Leave unset to run fail-closed BRS/matching rather than inventing a value.
RADAR_DOVE_SIMILARITY_THRESHOLD=

# New dataset-discovery parameters (not frozen business scoring).
RADAR_DISCOVERY_SIMILARITY_THRESHOLD=0.72
RADAR_DISCOVERY_TOP_K=8
RADAR_DISCOVERY_MIN_CLUSTER_SIZE=2
RADAR_DISCOVERY_EMBEDDING_DIMENSION=128

# Model names can be changed server-side without changing the domain contracts.
RADAR_GEMINI_MODEL=gemini-3.7-flash
RADAR_EMBEDDING_MODEL=gemini-embedding-2
PORT=3001
